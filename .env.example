
# Twilio SMS (for agent phone OTP verification)
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_auth_token
# TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# Admin notifications (new agent pending approval)
# ADMIN_NOTIFICATION_EMAIL=admin@okapi-real-estate.com
# DASHBOARD_URL=https://dashboard.okapi-real-estate.com

# Google OAuth (Sign in with Google)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=https://api.okapi.immo/auth/agent/google/callback

# WhatsApp Business Cloud API
WHATSAPP_TOKEN=your-meta-system-user-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
