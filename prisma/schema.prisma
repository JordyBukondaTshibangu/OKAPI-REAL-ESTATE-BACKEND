generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AgentVerificationTier {
  NON_VERIFIE
  VERIFIE
  PARTENAIRE_CONFIANCE
}

// Monetisation plan — determines listing cap and feature access.
// FREE agents get unlimited listings during graceEndsAt, then capped at 10.
// PRO and AGENCY are unlocked manually by an admin after payment confirmation.
enum AgentPlan {
  FREE
  PRO
  AGENCY
}

enum DocumentReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ReferenceType {
  AGENT
  AGENCY
  COMMISSIONNAIRE
}

enum ReferenceStatus {
  PENDING
  CONFIRMED
  REVOKED
  FLAGGED
}

enum AgencyVerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

model Admin {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String
  createdAt    DateTime   @default(now())

  auditLogs    AuditLog[]
}

model User {
  id                String    @id @default(uuid())
  firstName         String
  lastName          String
  email             String    @unique
  phoneNumber       String
  passwordHash      String
  resetToken        String?
  resetTokenExpiry  DateTime?
  profileImage      String?
  createdAt         DateTime  @default(now())

  favorites  Favorite[]
  enquiries  Enquiry[]
  alerts     Alert[]
  reviews    Review[]
  complaintsFiled AgentComplaint[]
}

model Agency {
  id              String   @id @default(uuid())
  name            String
  monogram        String
  accentClass     String
  tagline         String
  description     String
  address         String
  phone           String
  email           String
  website         String?
  founded         Int
  agentCount      Int      @default(0)
  listingCount    Int      @default(0)
  closedDeals     Int      @default(0)
  specializations String[]
  areasServed     String[]
  languages       String[]
  certifications  String[]

  // --- Agency verification gate ---
  // Heavier than the individual agent gate: an agency vouches for many
  // agents at once, so it needs business proof + at least one already
  // verified agent before it can fast-track its own staff.
  verificationStatus AgencyVerificationStatus @default(PENDING)
  businessProofUrl   String?
  approvedAt         DateTime?
  standingFlagged    Boolean                  @default(false)

  createdAt   DateTime @default(now())

  agents     Agent[]
  properties Property[]
  vouchesGiven AgentReference[]
}

model Agent {
  id               String  @id @default(uuid())
  // Independent agents (not yet affiliated with an agency) are allowed —
  // agency affiliation is optional, matching the tiered trust model where
  // agency approval is a separate, heavier gate above individual agents.
  agencyId         String?
  agency           Agency? @relation(fields: [agencyId], references: [id], onDelete: SetNull)

  name             String
  title            String  @default("Agent")
  specialization   String  @default("")
  nationality      String  @default("")
  languages        String[] @default([])
  yearsExperience  Int     @default(0)
  experienceSince  Int     @default(0)
  rating           Float   @default(0)
  ratingsCount     Int     @default(0)
  responseMinutes  Int     @default(0)
  // Not every agent has a formal license (e.g. an unlicensed commissionnaire),
  // so this is no longer mandatory at signup time.
  brokerLicense    String?
  forSaleCount     Int     @default(0)
  forRentCount     Int     @default(0)
  closedDeals      Int     @default(0)
  totalDealsValueUsd Float @default(0)
  bio              String  @default("")
  photo            String  @default("")
  photoGradient    String  @default("from-slate-400 to-slate-600")
  agencyAccent     String  @default("")
  agencyMonogram   String  @default("")

  // --- Self-signup auth ---
  email            String?   @unique
  passwordHash     String?
  phoneNumber      String?   @unique
  whatsappNumber   String?
  resetToken       String?
  resetTokenExpiry DateTime?

  // --- Phone OTP verification ---
  phoneOtpCode   String?
  phoneOtpExpiry DateTime?

  // --- Monetisation plan ---
  plan         AgentPlan @default(FREE)
  // Grace period: unlimited listings until this date, then capped at 10 for FREE.
  // Set to now() + 6 months on signup. Existing agents are backfilled.
  graceEndsAt  DateTime  @default(dbgenerated("now() + interval '6 months'"))
  // Whether the agent has been manually suspended by an admin.
  isSuspended     Boolean   @default(false)
  suspendedAt     DateTime?
  suspendedReason String?

  // --- Tiered trust / verification ---
  verificationTier    AgentVerificationTier @default(NON_VERIFIE)
  idDocumentUrl        String?
  idDocumentStatus     DocumentReviewStatus  @default(PENDING)
  firstListingChecked  Boolean               @default(false)
  verifiedAt           DateTime?
  partnerSince         DateTime?
  lastTierCheckedAt    DateTime?
  complaintCount       Int                   @default(0)
  flagged              Boolean               @default(false)

  createdAt        DateTime @default(now())

  properties       Property[]
  areasOfExpertise AreaOfExpertise[]
  trackRecord      TrackRecord[]
  reviews          Review[]

  referencesReceived AgentReference[] @relation("ReferenceReceiver")
  referencesGiven    AgentReference[] @relation("ReferenceGiver")
  complaints         AgentComplaint[]
}

// A "vouch": records who is endorsing a given agent during the
// Non-vérifié -> Vérifié step (a verified agent, an approved agency, or a
// named commissionnaire outside the platform). Kept as an internal scoring
// signal — not exposed in public API responses.
model AgentReference {
  id   String        @id @default(uuid())
  type ReferenceType

  agentId String
  agent   Agent  @relation("ReferenceReceiver", fields: [agentId], references: [id], onDelete: Cascade)

  voucherAgentId  String?
  voucherAgent    Agent?  @relation("ReferenceGiver", fields: [voucherAgentId], references: [id], onDelete: SetNull)
  voucherAgencyId String?
  voucherAgency   Agency? @relation(fields: [voucherAgencyId], references: [id], onDelete: SetNull)
  // Fallback for references that don't map to a platform account yet,
  // e.g. an external commissionnaire vouching by name/phone.
  voucherName    String?
  voucherContact String?

  status ReferenceStatus @default(PENDING)
  note   String?

  reviewedAt DateTime?
  createdAt  DateTime  @default(now())
}

// A complaint filed by a site visitor against an agent. Crossing the
// threshold flags the agent (and their agency) for re-review — this is
// the only ongoing manual workload once an agent reaches Tier 2+.
model AgentComplaint {
  id      String @id @default(uuid())
  agentId String
  agent   Agent  @relation(fields: [agentId], references: [id], onDelete: Cascade)

  reporterUserId String?
  reporterUser   User?   @relation(fields: [reporterUserId], references: [id], onDelete: SetNull)

  reason  String
  details String?
  status  String  @default("open")

  createdAt DateTime @default(now())
}

model AreaOfExpertise {
  id          String @id @default(uuid())
  agentId     String
  agent       Agent  @relation(fields: [agentId], references: [id])

  name        String
  description String
  rating      Float
  ratings     Int
  forSale     Int
  forRent     Int
  closedDeals Int
}

model TrackRecord {
  id           String @id @default(uuid())
  agentId      String
  agent        Agent  @relation(fields: [agentId], references: [id])

  location     String
  building     String
  dealType     String
  date         String
  propertyType String
  bedrooms     String
}

model Property {
  id              String   @id @default(uuid())
  agentId         String
  agent           Agent    @relation(fields: [agentId], references: [id])
  agencyId        String
  agency          Agency   @relation(fields: [agencyId], references: [id])

  listingType     String
  category        String
  price           Float
  currency        String
  period          String?
  title           String
  subtitle        String
  bedrooms        Int
  bathrooms       Int
  areaSqm         Float
  suburb          String
  neighborhood    String
  city            String
  verified        Boolean  @default(false)
  premium         Boolean  @default(false)
  isNew           Boolean  @default(false)
  listedDaysAgo   Int      @default(0)
  imageGradient   String
  iconType        String
  transaction     String?
  gallery         String[]
  amenities       String[]

  description     String?
  reference       String?
  zone            String?
  brokerLicense   String?
  agentLicense    String?
  permitNumber    String?
  availableFrom   String?
  averagePriceArea Float?
  averageSizeArea  Float?

  viewCount       Int      @default(0)
  shareCount      Int      @default(0)

  // Boost: paid placement — listing appears first in search until this date.
  boostedUntil    DateTime?

  createdAt       DateTime @default(now())

  favorites  Favorite[]
  enquiries  Enquiry[]
  reviews    Review[]
}

model Favorite {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, propertyId])
}

model Enquiry {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  message    String
  status     String   @default("pending")
  createdAt  DateTime @default(now())
}

model Alert {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  listingType String?
  category    String?
  minPrice    Float?
  maxPrice    Float?
  city        String?
  suburb      String?
  minBedrooms Int?
  maxBedrooms Int?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model Review {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  propertyId String?
  property   Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  agentId    String?
  agent      Agent?    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  rating     Int
  comment    String?
  createdAt  DateTime  @default(now())
}

model AuditLog {
  id         String   @id @default(uuid())
  adminId    String
  admin      Admin    @relation(fields: [adminId], references: [id])
  action     String
  resource   String
  resourceId String?
  details    String?
  createdAt  DateTime @default(now())
}
